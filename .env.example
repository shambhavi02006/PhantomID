# =================================================================
# PhantomID Environment Configuration
# All external keys are optional! 
# The application has intelligent local fallbacks if keys are left blank.
# =================================================================

# 1. MongoDB Atlas (Prize: Best Use of MongoDB Atlas - $100)
# Leave blank to use local SQLite (phantom.db) automatically
MONGO_URI=
MONGO_DB_NAME=phantomid_db

# 2. DeepMind Google Gemma 4 / Multimodal via Gemini API (Prize: Deepmind Google Track)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 3. Google Gemma via Hugging Face (Alternative)
HF_TOKEN=
HF_MODEL_ID=google/gemma-2-9b-it

# 3. Sentry Agent Tracing (Prize: Best Use of Sentry Agent Tracing - $100)
# Get your free DSN at https://sentry.io/
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# 4. ElevenLabs Voice API (Prize: Best Use of ElevenLabs - $100)
# Get your free key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Flask Server Config
PORT=5001
FLASK_DEBUG=True

